<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f59e0b"/>
      <stop offset="100%" style="stop-color:#d97706"/>
    </linearGradient>
  </defs>
  <!-- Outer circle -->
  <circle cx="100" cy="100" r="95" fill="none" stroke="url(#goldGrad)" stroke-width="4"/>
  <circle cx="100" cy="100" r="88" fill="none" stroke="url(#goldGrad)" stroke-width="2"/>
  <!-- Inner dark circle -->
  <circle cx="100" cy="100" r="75" fill="#1e293b"/>
  <!-- Map silhouette (simplified) -->
  <path d="M70 60 Q80 45 100 50 Q120 40 130 55 Q140 60 135 80 Q145 90 140 110 Q135 130 120 135 Q110 145 95 140 Q80 145 70 135 Q60 120 55 100 Q55 80 70 60Z" fill="#d97706" opacity="0.8"/>
  <!-- Mining pick -->
  <line x1="90" y1="85" x2="110" y2="115" stroke="#f59e0b" stroke-width="3"/>
  <path d="M105 80 L115 90 L108 92Z" fill="#f59e0b"/>
  <path d="M85 108 L95 118 L88 120Z" fill="#f59e0b"/>
  <!-- Company name arc -->
  <path id="topArc" d="M30 100 A70 70 0 0 1 170 100" fill="none"/>
  <text fill="#f59e0b" font-family="Inter, sans-serif" font-size="9" font-weight="bold">
    <textPath href="#topArc" startOffset="50%" text-anchor="middle">PT NUSA HALMAHERA MINERALS</textPath>
  </text>
  <path id="bottomArc" d="M35 105 A65 65 0 0 0 165 105" fill="none"/>
  <text fill="#f59e0b" font-family="Inter, sans-serif" font-size="9" font-weight="bold">
    <textPath href="#bottomArc" startOffset="50%" text-anchor="middle">GOSOWONG GOLD MINE</textPath>
  </text>
  <!-- Placeholder text -->
  <text x="100" y="175" text-anchor="middle" fill="#64748b" font-family="Inter, sans-serif" font-size="8">[Replace with actual logo]</text>
</svg>
