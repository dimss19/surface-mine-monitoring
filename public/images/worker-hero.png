<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500" width="400" height="500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e293b"/>
      <stop offset="100%" style="stop-color:#0f172a"/>
    </linearGradient>
  </defs>
  <rect width="400" height="500" fill="url(#bg)"/>
  <!-- Hard hat -->
  <ellipse cx="200" cy="180" rx="70" ry="30" fill="#f59e0b"/>
  <rect x="130" y="140" width="140" height="40" rx="10" fill="#f59e0b"/>
  <rect x="160" y="130" width="80" height="20" rx="8" fill="#d97706"/>
  <!-- Head -->
  <circle cx="200" cy="200" r="35" fill="#fbbf24"/>
  <!-- Eyes -->
  <circle cx="188" cy="195" r="4" fill="#0f172a"/>
  <circle cx="212" cy="195" r="4" fill="#0f172a"/>
  <!-- Smile -->
  <path d="M185 210 Q200 225 215 210" stroke="#0f172a" stroke-width="2" fill="none"/>
  <!-- Body - orange vest -->
  <rect x="150" y="235" width="100" height="80" rx="8" fill="#f97316"/>
  <!-- Reflective stripes -->
  <rect x="150" y="260" width="100" height="6" fill="#e2e8f0"/>
  <rect x="150" y="290" width="100" height="6" fill="#e2e8f0"/>
  <!-- Arms crossed -->
  <rect x="130" y="250" width="30" height="60" rx="6" fill="#f97316"/>
  <rect x="240" y="250" width="30" height="60" rx="6" fill="#f97316"/>
  <!-- Gloves -->
  <rect x="125" y="295" width="35" height="20" rx="5" fill="#d97706"/>
  <rect x="240" y="295" width="35" height="20" rx="5" fill="#d97706"/>
  <!-- Safety glasses -->
  <rect x="175" y="188" width="20" height="12" rx="3" fill="none" stroke="#0f172a" stroke-width="2"/>
  <rect x="205" y="188" width="20" height="12" rx="3" fill="none" stroke="#0f172a" stroke-width="2"/>
  <line x1="195" y1="194" x2="205" y2="194" stroke="#0f172a" stroke-width="2"/>
  <!-- Text placeholder -->
  <text x="200" y="420" text-anchor="middle" fill="#64748b" font-family="Inter, sans-serif" font-size="14">Mining Worker</text>
  <text x="200" y="440" text-anchor="middle" fill="#475569" font-family="Inter, sans-serif" font-size="11">[Replace with actual image]</text>
</svg>
